+class DirectContentRouteError(GraphError):
+    """A body request must wait for an approved direct destination."""
+
+
+DIRECT_CONTENT_HOSTS = frozenset({"my.microsoftpersonalcontent.com"})
+DIRECT_CONTENT_SUFFIXES = ("up.1drv.com", "files.1drv.com", "livefilestore.com", "mediap.svc.ms")
+
+
+def require_direct_content_url(url: str) -> str:
+    """Reject unknown body destinations without ever serializing signed URLs."""
+    try:
+        parsed = urlsplit(url)
+        host = (parsed.hostname or "").lower()
+        allowed = host in DIRECT_CONTENT_HOSTS or any(
+            host == suffix or host.endswith("." + suffix) for suffix in DIRECT_CONTENT_SUFFIXES
+        )
+        if not allowed or parsed.scheme != "https" or parsed.port not in (None, 443) or parsed.username is not None or parsed.password is not None or parsed.fragment:
+            raise ValueError
+    except (ValueError, TypeError):
+        raise DirectContentRouteError("WAITING_FOR_DIRECT_ROUTE: unapproved content destination", plane="DATA", failure_kind="DIRECT_ROUTE_REQUIRED") from None
+    return url
+
+
